{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["AnimalApp.ts", "controller/**/*.ts", "model/**/*.ts", "view/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
