<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
    <type>org.netbeans.modules.ant.freeform</type>
    <configuration>
        <general-data xmlns="http://www.netbeans.org/ns/freeform-project/1">
            <name>Cellphone_TypeScript_03</name>
            <folders>
                <source-folder>
                    <label>TypeScript source</label>
                    <location>src</location>
                </source-folder>
                <source-folder>
                    <label>Data</label>
                    <location>data</location>
                </source-folder>
            </folders>
            <ide-actions>
                <action name="build"><target>build</target></action>
                <action name="clean"><target>clean</target></action>
                <action name="rebuild"><target>clean</target><target>build</target></action>
            </ide-actions>
            <view>
                <items>
                    <source-folder style="tree"><label>TypeScript source</label><location>src</location></source-folder>
                    <source-folder style="tree"><label>JSON data</label><location>data</location></source-folder>
                    <source-file><location>package.json</location></source-file>
                    <source-file><location>tsconfig.json</location></source-file>
                    <source-file><location>build.xml</location></source-file>
                    <source-file><location>README.md</location></source-file>
                </items>
                <context-menu>
                    <ide-action name="build"/>
                    <ide-action name="rebuild"/>
                    <ide-action name="clean"/>
                </context-menu>
            </view>
        </general-data>
    </configuration>
</project>
